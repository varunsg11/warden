# Copy this file to ".env" and fill in your real key. The .env file is gitignored.
# python-dotenv loads these into the environment when Warden starts.

OPENAI_API_KEY=sk-...your-key-here...

# Which OpenAI model the agents run on. gpt-4o-mini is cheap and plenty foolable.
WARDEN_MODEL=gpt-4o-mini

# Set to 1 to run with the deterministic fake LLM (no API calls, no cost).
# Great for tests and for developing the governance layer offline.
WARDEN_FAKE_LLM=0
